# Keycloak (backend + frontend)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=gallery
KEYCLOAK_CLIENT_ID=gallery-app

# MinIO (backend only). Port 9000 = S3 API, 9001 = Web Console
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=gallery

# Backend
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# Frontend (Next.js) - use in frontend/.env.local
# NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
# NEXT_PUBLIC_KEYCLOAK_REALM=gallery
# NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=gallery-app
# NEXT_PUBLIC_API_URL=http://localhost:4000

# Keycloak email verification: configure SMTP in Keycloak Admin → Realm → Realm settings → Email
